<Page x:Class="WpfApp5.WorkoutFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp5"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WorkoutFormPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Label Content="ID"/>
            <Label Content="Название"/>
            <Label Content="Дата"/>
            <Label Content="Тип"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Margin="5" Padding="0,5,0,5" Text="{Binding CurrentWorkout.Id}"/>
            <TextBox Margin="5" Text="{Binding CurrentWorkout.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding CurrentWorkout.Date}"/>
            <TextBox Margin="5" Text="{Binding CurrentWorkout.Type, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Label VerticalAlignment="Center">Упражнение:</Label>
            <TextBox x:Name="tbExName" Width="120" Margin="5"/>
            <Label VerticalAlignment="Center">Подходов:</Label>
            <TextBox x:Name="tbExSets" Width="40" Margin="5"/>
            <Label VerticalAlignment="Center">Время подхода (мин):</Label>
            <TextBox x:Name="tbExSetDuration" Width="40" Margin="5"/>
            <Button Click="AddExercise_Click" Margin="5" Padding="5">Добавить</Button>
            <Button Click="DeleteExercise_Click" Margin="5" Padding="5">Удалить</Button>
        </StackPanel>

        <ListView Grid.Row="2"
                  Grid.ColumnSpan="3"
                  ItemsSource="{Binding CurrentWorkout.Exercises}"
                  SelectedItem="{Binding SelectedExercise}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название: "/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Подходов: "/>
                            <TextBlock Text="{Binding Sets}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Длительность подхода (мин): "/>
                            <TextBlock Text="{Binding SetDurationMinutes}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Длительность упражнения (мин): "/>
                            <TextBlock Text="{Binding ExerciseDurationMinutes}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Background="AntiqueWhite">
            <Label>Общая продолжительность (мин):</Label>
            <Label Content="{Binding CurrentWorkout.WorkoutDurationMinutes}"/>
            <Button Click="SaveButton_Click" Margin="5" Padding="5">Сохранить</Button>
            <Button Click="BackButton_Click" Margin="5" Padding="5">Назад</Button>
        </StackPanel>
    </Grid>
</Page>
